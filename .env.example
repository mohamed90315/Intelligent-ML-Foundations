# Environment Variables Configuration
# Copy this file to .env and adjust the values as necessary

# The absolute or relative path to the KDD dataset CSV file.
# If not set, it defaults to checking the `data/` folder.
DATASET_PATH=./data/Sample_KDD.csv

# If you are running the perceptron code in an environment without a display
# set HEADLESS to true to save plots to disk instead of displaying them.
HEADLESS=false
